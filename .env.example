# Empty/unset: local draft lessons. Set to your own public API to load GET /lessons.
# No tokens or secrets: VITE_ variables are visible in the browser.
VITE_API_BASE_URL=

# Supabase Connect → Project URL + publishable key (or legacy anon key).
# Never use sb_secret_* or a service_role key in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
